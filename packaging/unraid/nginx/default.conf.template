# OpenFamily client - Unraid packaging override (nginx envsubst template).
#
# Place this file in /mnt/user/appdata/openfamily/nginx/ and map that folder to
# /etc/nginx/templates in the OpenFamily-Client container. The stock nginx image
# entrypoint renders it to /etc/nginx/conf.d/default.conf at container start,
# substituting ${OPENFAMILY_SERVER_ADDR} (set it as a container variable, e.g.
# 192.168.1.50:3001). Runtime nginx variables ($host, $uri, ...) are preserved.
#
# It makes the app same-origin: the client serves the SPA, proxies /api, /ws and
# /health to the OpenFamily server, and rewrites the absolute
# http://localhost:3001 URLs baked into the published client bundle.
server {
    listen 80;
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    # Gzip compression
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_types text/plain text/css text/xml text/javascript application/x-javascript application/xml+rss application/javascript application/json;

    # Security headers
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;

    # Rewrite build-time absolute URLs to same-origin so the proxy below is used.
    sub_filter_types application/javascript text/javascript;
    sub_filter_once off;
    sub_filter 'http://localhost:3001' '';
    sub_filter 'ws://localhost:3001' '';

    # REST API
    location /api/ {
        proxy_pass http://${OPENFAMILY_SERVER_ADDR};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Server health endpoint
    location = /health {
        proxy_pass http://${OPENFAMILY_SERVER_ADDR};
    }

    # WebSocket (live updates)
    location /ws {
        proxy_pass http://${OPENFAMILY_SERVER_ADDR};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    # SPA routing
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Cache static assets
    location ~* \.(js|css|png|jpg|jpeg|gif|ico|svg|woff|woff2|ttf|eot)$ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Service worker must never be cached (exact match so it beats the regex above)
    location = /sw.js {
        add_header Cache-Control "no-cache";
        expires off;
        access_log off;
    }
}
