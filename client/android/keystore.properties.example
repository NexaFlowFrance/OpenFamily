# Copiez ce fichier en `keystore.properties` (dans client/android/) et remplissez-le.
# Ce vrai fichier est gitignoré : il ne doit JAMAIS être commité ni partagé.
#
# `storeFile` est résolu relativement à client/android/ (ex. si vous placez la clé
# dans client/android/upload-keystore.jks, laissez la valeur ci-dessous telle quelle).

storeFile=upload-keystore.jks
storePassword=REMPLACER_PAR_LE_MOT_DE_PASSE_DU_KEYSTORE
keyAlias=upload
keyPassword=REMPLACER_PAR_LE_MOT_DE_PASSE_DE_LA_CLE
